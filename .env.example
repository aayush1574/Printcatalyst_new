# MongoDB Atlas Connection String (Permanent Cloud Persistence)
# Get a free cluster at: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/printcatalyst?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Override database name (defaults to 'printcatalyst')
MONGODB_DB_NAME=printcatalyst

# Server port (defaults to 5000)
PORT=5000
